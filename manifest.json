{
  "manifest_version": 3,
  "name": "Tab Group Summarizer",
  "description": "Summarize all tabs in a tab group using AI",
  "version": "1.0.0",
  "permissions": [
    "tabGroups",
    "tabs",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
