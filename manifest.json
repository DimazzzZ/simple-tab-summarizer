{
  "manifest_version": 3,
  "name": "Simple Tab Summarizer",
  "description": "Free on-device AI summarizer for tabs, tab groups, and reading lists. Works out-of-the-box with Chrome's built-in AI; optional ChatGPT sign-in for 40+ languages.",
  "version": "1.3.0",
  "permissions": [
    "tabGroups",
    "tabs",
    "scripting",
    "storage",
    "readingList",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*",
    "https://auth.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shadow-monkeypatch-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
